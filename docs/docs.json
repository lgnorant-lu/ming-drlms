                "icon": "rocket",
                "pages": [
                  "zh/index",
                  "zh/quickstart",
                  "zh/installation"
                ]
              },
              {
                "group": "环境配置",
                "icon": "gear",
                "pages": [
                  "zh/setup/environment-variables",
                  "zh/setup/config-file",
                  "zh/setup/windows",
                  "zh/setup/wsl"
                ]
              },
              {
                "group": "使用指南",
                "icon": "book",
                "pages": [
                  "zh/guides/cli-basics",
                  "zh/guides/tui-usage",
                  "zh/guides/tui-keybindings",
                  "zh/guides/relay-mode",
                  "zh/guides/mp2-mode",
                  "zh/guides/e2ee-setup",
                  "zh/guides/liboqs-install",
                  "zh/guides/rooms",
                  "zh/guides/identity-management",
                  "zh/guides/trust-verification",
                  "zh/guides/mcp-integration"
