{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "DRLMS",
  "description": "分布式实时日志监控系统 - 端到端加密通信协议",
  "colors": {
    "primary": "#5C9E31",
    "light": "#7CBA4D",
    "dark": "#4ECDC4"
  },
  "appearance": {
    "default": "system",
    "background": {
      "decoration": "gradient",
      "color": {
        "light": "#FDFCF7",
        "dark": "#1E2D24"
      }
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "nord"
      }
    }
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "zh",
        "tabs": [
          {
