#!/usr/bin/env bash

# Determine repo root and move there
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Collect staged files (added/copied/modified/renamed/type-changed)
mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACMRT)

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
  exit 0
fi

have_failed=0
cf_files=()
py_files=()

for file in "${STAGED_FILES[@]}"; do
  # Track files for re-staging regardless of physical availability
  # (git add gracefully skips non-existent paths in this context)
  if [ -f "$file" ]; then
    case "$file" in
      *.c|*.h)
        cf_files+=("$file")
        ;;
    esac

    if [[ "$file" == *.py && "$file" != "src/ming_drlms/_version.py" ]]; then
      py_files+=("$file")
    fi
  fi
done

# Handle C/C++ files with clang-format (optional tool)
if [ ${#cf_files[@]} -gt 0 ]; then
  if command -v clang-format >/dev/null 2>&1; then
    echo "[pre-commit] Running clang-format..."
    if ! clang-format -i "${cf_files[@]}"; then
      echo "[pre-commit] clang-format failed" >&2
      have_failed=1
    fi
  else
    echo "[pre-commit] WARNING: clang-format not found in PATH, skipping C/C++ formatting" >&2
    # Don't fail the commit if clang-format is missing and there are C files
    # This allows CI to work even without clang-format installed
  fi
fi

# Handle Python files with ruff (required tool)
if [ ${#py_files[@]} -gt 0 ]; then
  if command -v ruff >/dev/null 2>&1; then
    echo "[pre-commit] Running ruff format + fix..."
    if ! ruff format -- "${py_files[@]}"; then
      echo "[pre-commit] ruff format failed" >&2
      have_failed=1
    fi
    if ! ruff check --fix -- "${py_files[@]}"; then
      echo "[pre-commit] ruff check failed" >&2
      have_failed=1
    fi
  else
    echo "[pre-commit] ERROR: ruff not found in PATH" >&2
    have_failed=1
  fi
fi

# Re-stage any formatter changes
if [ ${#STAGED_FILES[@]} -gt 0 ]; then
  git add -- "${STAGED_FILES[@]}"
fi

if [ "$have_failed" -ne 0 ]; then
  echo "[pre-commit] Formatting failed. Aborting commit." >&2
  exit 1
fi

exit 0


