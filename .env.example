# =============================================================================
# DRLMS 环境变量配置文件模板
# =============================================================================
# 使用方法：
#   1. 复制此文件为 .env.local (Windows) 或 .env.wsl (WSL/Linux)
#   2. 按需修改配置值
#   3. 在终端加载：
#      - Windows PowerShell: Get-Content .env.local | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [System.Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
#      - WSL/Linux: export $(grep -v '^#' .env.wsl | xargs)
#   4. 或使用 scripts/load-env.ps1 / scripts/load-env.sh
#
# 注意：此文件不应提交到 Git，已在 .gitignore 中排除 .env.* 文件
# =============================================================================

# =============================================================================
# 1. 配置路径与目录
# =============================================================================

# 配置目录覆盖（优先级最高）
# Windows 默认: %APPDATA%\DRLMS
# WSL/Linux 默认: ~/.config/drlms
# MING_DRLMS_CONFIG_DIR=

# TUI 状态目录（离线队列、令牌等）
# 默认: ~/.drlms
# MING_DRLMS_STATE_DIR=

# 配置文件完整路径覆盖（高于 MING_DRLMS_CONFIG_DIR）
# DRLMS_CONFIG_FILE=

# 数据目录（日志、数据库等）
# Windows 默认: %LOCALAPPDATA%\drlms
# WSL/Linux 默认: ~/.local/share/drlms
# DRLMS_DATA_DIR=

# 项目根目录覆盖（CLI 工具查找路径）
# DRLMS_ROOT=

# =============================================================================
# 2. 后端选择与服务器配置
# =============================================================================

# 后端类型：mp2（传统 MProto V2）或 relay（P2P 中继）
# 默认: mp2
# 注意：推荐使用 DRLMS_BACKEND_MODE（Phase 18+），此变量为兼容别名
DRLMS_BACKEND_MODE=mp2
# DRLMS_BACKEND=mp2  # [Legacy] 兼容别名，优先读取 DRLMS_BACKEND_MODE

# --- MP2 服务器配置 ---
DRLMS_MP2_HOST=127.0.0.1
DRLMS_MP2_PORT=15035
# 推荐：让 MP2 端口与 C 端服务器 DRLMS_PORT 保持一致（开发环境统一使用 15035）
DRLMS_MP2_TLS=0

# --- Relay 服务器配置 ---
# 推荐使用 DRLMS_DEFAULT_RELAYS（Phase 18+，支持多 Relay）
DRLMS_DEFAULT_RELAYS=http://127.0.0.1:15019
# DRLMS_RELAY_BASE_URL=http://127.0.0.1:15019  # [Legacy] 兼容别名，单 Relay

# =============================================================================
# 3. P2P 安全策略
# =============================================================================

# P2P 严格模式总开关（0=全部关闭，1=全部开启）
# 优先级高于下方单项设置
# DRLMS_STRICT_P2P=1

# 单项设置（0=关闭，1=开启）
# DRLMS_REQUIRE_IDENTITY_SIG=1
DRLMS_RELAY_ENFORCE_SIGNED=1
DRLMS_RELAY_STRICT_MODE=1

# 身份签名时间偏移容忍窗口（秒）
DRLMS_IDENTITY_SIG_MAX_SKEW=300

# =============================================================================
# 4. 日志配置（Python + C 通用）
# =============================================================================

# 日志级别: DEBUG, INFO, WARN, ERROR
DRLMS_LOG_LEVEL=INFO

# 日志目录（两端统一）
# DRLMS_LOG_DIR=

# 日志轮转模式: size（按大小）或 time（按时间）
DRLMS_LOG_ROTATE=size

# 保留日志文件数量
DRLMS_LOG_KEEP=5

# 单个日志文件最大大小（MB）
DRLMS_LOG_MAX_MB=10

# 控制台输出（0=关闭，1=开启）
DRLMS_LOG_CONSOLE=1

# JSON 格式日志（0=关闭，1=开启，生成 .jsonl 文件）
DRLMS_LOG_JSON=0

# =============================================================================
# 5. C 端专用日志配置（覆盖通用设置）
# =============================================================================

# 如需 C 端独立配置，取消注释并修改
# DRLMS_C_LOG_LEVEL=INFO
# DRLMS_C_LOG_DIR=
# DRLMS_C_LOG_ROTATE=size
# DRLMS_C_LOG_KEEP=5
# DRLMS_C_LOG_MAX_MB=10
# DRLMS_C_LOG_CONSOLE=1
# DRLMS_C_LOG_JSON=0

# Windows 专用：OutputDebugString 输出
# DRLMS_C_LOG_WINDBG=0

# =============================================================================
# 6. 更新检查
# =============================================================================

# 更新检查开关（0=关闭，1=开启）
# CI 环境建议设为 0
DRLMS_UPDATE_CHECK=1

# =============================================================================
# 7. CLI/Relay 命令专用
# =============================================================================

# 当前用户名（用于 relay post/sync 命令）
# DRLMS_USER=

# 用户密码（避免命令行暴露）
# DRLMS_PASSWORD=

# 签名公钥映射文件（JSON格式，{"sender#device": "hex_pubkey"}）
# DRLMS_SIGNING_PUBKEYS_FILE=

# 用户列表文件
# DRLMS_USERS_FILE=

# CLI Banner（1=显示品牌 Banner）
# DRLMS_BANNER=0

# =============================================================================
# 8. CMake 构建配置
# =============================================================================

# 构建目录
# DRLMS_CMAKE_BUILD_DIR=build

# 构建类型
# CMAKE_BUILD_TYPE=Release

# CMake 额外配置参数
# DRLMS_CMAKE_CONFIG_ARGS=

# 构建配置（多配置生成器如 MSVC）
# DRLMS_CMAKE_BUILD_CONFIG=Release

# 默认 CMake 配置（用于 CLI/Server 构建脚本）
# DRLMS_DEFAULT_CMAKE_CONFIG=RelWithDebInfo

# 运行时二进制目录（外部工具/桥接库查找）
# DRLMS_RUNTIME_BIN_DIR=

# vcpkg 工具链文件
# CMAKE_TOOLCHAIN_FILE=
# VCPKG_ROOT=

# =============================================================================
# 9. 服务器运行配置
# =============================================================================

# 服务器监听端口（C 端服务器）
# 默认编译端口通常为 15034；推荐在本地开发时将 C 端和 MP2 统一到 15035：
#   - Windows: set DRLMS_PORT=15035 & .\\build_win_ninja_x64\\log_collector_server.exe
#   - WSL/Linux: export DRLMS_PORT=15035 && ./build_wsl/log_collector_server
DRLMS_PORT=15035

# 服务器数据目录（users.txt, drlms.db 等）
# 必须与客户端保持一致以确保认证成功
# Windows: 项目根目录下的 server_files
# WSL: /mnt/d/.../DRLMS/server_files
# DRLMS_DATA_DIR=server_files

# 启用 MP2 协议（C 端服务器）
# 0=禁用（仅 legacy text 协议），1=启用
DRLMS_ENABLE_MPROTO_V2=1

# 最大并发连接数
# DRLMS_MAX_CONN=128

# TCP Keep-Alive 配置
# DRLMS_TCP_KEEPALIVE=1
# DRLMS_TCP_KEEPIDLE=60
# DRLMS_TCP_KEEPINTVL=10
# DRLMS_TCP_KEEPCNT=3

# 测试/开发用模拟服务器模式
# DRLMS_FAKE_SERVER=0
# DRLMS_FAKE_SERVER_PID=

# =============================================================================
# 10. 开发/测试专用
# =============================================================================

# ⚠️ 开发后门：跳过密码验证（仅限开发/测试环境！）
# 设为 1 时，MP2 服务器接受任意用户名+任意密码登录
# 生产环境绝对不要启用！
DRLMS_MP2_ACCEPT_ANY=0

# 认证严格模式（legacy text 协议）
# 0=宽松（无 users.txt 时允许任意登录），1=严格
DRLMS_AUTH_STRICT=1

# --- MP2 上传限制 ---
# 最大上传文件大小（字节，默认 100MB）
# DRLMS_MP2_MAX_UPLOAD=104857600

# --- 速率限制（C 服务器）---
# 上传速率限制（字节/秒，0=不限）
# DRLMS_RATE_UP_BPS=0
# 下载速率限制（字节/秒，0=不限）
# DRLMS_RATE_DOWN_BPS=0

# --- 房间实例/容量相关（保留，C 服务器未实现读取） ---
# 以下变量由 Python CLI 传递给 C 服务器，但 C 服务器当前使用数据库默认值
# DRLMS_DEFAULT_INSTANCE_CAPACITY=50
# 单房间最大实例数
# DRLMS_MAX_INSTANCES_PER_ROOM=20
# 空闲实例回收 TTL（秒）
# DRLMS_INSTANCE_IDLE_TTL=86400
# 实例 GC 周期（秒）
# DRLMS_INSTANCE_GC_INTERVAL=60
# 临时消息历史上限（条）
# DRLMS_EPHEMERAL_HISTORY_LIMIT=1000

# 测试详细输出（服务器端调试日志）
# DRLMS_TEST_VERBOSE=0

# MP2 协议调试输出
# DRLMS_MP2_DEBUG=0

# 共享内存 Key（CLI/Server IPC 通信，可选）
# 例如：0x4c4f4754
# DRLMS_SHM_KEY=

# =============================================================================
# 11. 国际化
# =============================================================================

# 语言设置
# DRLMS_LANG=en

# =============================================================================
# 12. XDG 标准目录（Linux/WSL）
# =============================================================================

# XDG 配置目录（代码使用）
# XDG_CONFIG_HOME=~/.config

# =============================================================================
# 13. 安全与加密
# =============================================================================

# JWT 签名密钥（服务器端）
# 生产环境必须更换为强随机密钥！
# DRLMS_JWT_SECRET=dev-secret

# 服务器 Salt（用于认证握手）
# DRLMS_SERVER_SALT=mp2

# Signal 库安装路径（CFFI 加载用）
# WSL: build_wsl/_deps/signal-install
# Windows: 由 CMake 自动配置
# DRLMS_SIGNAL_PREFIX=

# Argon2 密码哈希参数
# DRLMS_ARGON2_T_COST=2
# DRLMS_ARGON2_M_COST=65536
# DRLMS_ARGON2_PARALLELISM=1

# =============================================================================
# 14. Phase 15.5: XEdDSA 统一身份
# =============================================================================

# 当前用户名（必需，用于 LocalKeyStore 身份查找）
# 与 Section 7 的 DRLMS_USER 相同
DRLMS_USER=

# =============================================================================
# Phase 15.5 说明：
# - 身份密钥统一使用 X25519 + XEdDSA 签名
# - 密钥存储于 LocalKeyStore (e2ee_keys.json)
# - MP2 登录签名默认使用 XEdDSA（无需配置）
# - 服务端仅验证 XEdDSA（Ed25519 验证已移除）
# - 文件路径由 MING_DRLMS_CONFIG_DIR 派生：
#   - e2ee_keys.json — E2EE 密钥存储
#   - contacts.json — 联系人
#   - trust_store.json — 信任存储
#   - rooms.json — 房间状态
# =============================================================================

# =============================================================================
# 15. Phase 16: 多 Relay 与可靠性
# =============================================================================

# [已废弃] DRLMS_RELAY_SIGNING_KEY - Phase 17C 已移除 HMAC
# [已废弃] DRLMS_RELAY_KEY_{relay_id} - Phase 17C 使用 XEdDSA 公钥验证

# Relay 身份标识（用于回执签名）
# 默认: relay-default
DRLMS_RELAY_ID=relay-default

# --- Relay 配置文件路径 ---
# 配置 Relay 发现、健康检查、离线队列等参数
# 默认: $MING_DRLMS_CONFIG_DIR/relays.toml
# DRLMS_RELAYS_CONFIG=

# --- Relay 数据库路径（服务端）---
# 默认: drlms.db（当前目录）
# DRLMS_DB_PATH=drlms.db

# --- Relay 文件存储目录（服务端）---
# 默认: relay_files（当前目录）
# DRLMS_FILES_DIR=relay_files

# =============================================================================
# Phase 16 说明：
# - 多 Relay 并行写入，故障自动转移
# - 回执签名验证写入可靠性（Phase 17C: XEdDSA only）
# - 离线队列持久化（SQLite），网络恢复自动重发
# - Merkle Tree 同步，增量拉取缺失事件
# - 健康检查与评分系统，自动降级不健康 Relay
# =============================================================================

# =============================================================================
# 16. Phase 17: 非对称签名 (XEdDSA) - Phase 17C 完成
# =============================================================================

# --- Relay 服务端 XEdDSA 签名私钥 (必需) ---
# 32 字节 hex 编码 (64 字符)
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
# 必须设置，否则 Relay 无法签名回执
DRLMS_RELAY_SIGNING_PRIVKEY=

# =============================================================================
# Phase 17C 说明：
# - XEdDSA 非对称签名（Ed25519）
# - HMAC 对称签名已移除
# - 公钥通过 /health 或 /.well-known/drlms-relay.json 自动发现
# - 客户端使用公钥验证回执签名
# =============================================================================

# =============================================================================
# 17. Phase 18: Relay 去中心化核心
# =============================================================================

# 后端模式/Relay 列表已在 Section 2 定义 (DRLMS_BACKEND_MODE, DRLMS_DEFAULT_RELAYS)

# --- Keyserver 配置 ---
# 查询超时（秒）
DRLMS_KEYSERVER_TIMEOUT=5.0

# --- 信任策略 ---
# tofu: 首次信任（默认）
# manual_only: 仅手动验证
# anchored_only: 仅外部锚定
DRLMS_TRUST_POLICY=tofu

# --- 公钥变更行为 ---
# warn: 警告，让用户决定（默认）
# block: 自动阻止直到验证
# reset: 重置信任级别到 TOFU
DRLMS_KEY_CHANGE_ACTION=warn

# =============================================================================
# Phase 18 说明：
# - 本地身份自举（无需中心服务器）
# - 多级信任模型：TOFU → 手动验证 → 社交担保 → 外部锚定
# - PreKey Bundle 通过 Keyserver 房间分发
# - Relay-Native 房间：私有/公开/未列出
# - 邀请链接格式：drlms://room/{room_id}?key=...&relays=...
# =============================================================================

# =============================================================================
# 18. Phase 19: Relay Mode Complete
# =============================================================================

# Phase 19 使用 Phase 18 的配置项，无新增环境变量。
# 主要功能：
# - CLI: ming-drlms chat send/recv/publish-bundle
# - TUI: Relay 模式启动界面 + 聊天视图
#
# 使用示例：
# 1. 设置 Relay 模式
#    DRLMS_BACKEND_MODE=relay
#    DRLMS_DEFAULT_RELAYS=http://localhost:15019
#
# 2. 创建本地身份
#    ming-drlms identity create --name "myuser"
#
# 3. 发送消息
#    ming-drlms chat send --to <pubkey> --message "hello"
#
# 4. 启动 TUI
#    ming-drlms tui
#
# =============================================================================
# Phase 19 说明：
# - CLI/TUI 完整 Relay 模式支持
# - 无需 C 服务器即可运行聊天功能
# - MP2 和 Relay 模式共存，通过 DRLMS_BACKEND_MODE 切换
# =============================================================================
